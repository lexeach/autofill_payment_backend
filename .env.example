# Create TEST keys in your Razorpay Dashboard. Never put secret keys in the extension.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
PORT=4242
# Optional comma-separated origins for your deployed extension dashboard/backend clients.
CORS_ORIGINS=chrome-extension://replace_with_extension_id,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4242
