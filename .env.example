# MongoDB Atlas connection string (keep secret; never commit .env)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=autofill_payments
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
CORS_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
PORT=4242

# Generate a random secret of at least 32 characters
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Admin panel credentials (store only in Render Environment, never in frontend code)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_14_characters
